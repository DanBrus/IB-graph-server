match
  $board isa board, has b_id {b_id};
fetch {{
  "b_id": $board.b_id,
  "name": $board.name,
  "description": $board.description,
  "is_published": $board.is_published,
  "node_ids": [
    match
      board-has-node(board: $board, member-node: $node);
      $node has n_id $node_n_id;
    return {{ $node_n_id }};
  ],
  "edge_ids": [
    match
      board-has-edge(board: $board, member-edge: $edge);
      $edge has ed_id $edge_ed_id;
    return {{ $edge_ed_id }};
  ]
}};
