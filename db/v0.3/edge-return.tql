match
  $edge isa edge, has ed_id {ed_id}, links (endpoint-1: $endpoint1, endpoint-2: $endpoint2);
fetch {{
  "ed_id": $edge.ed_id,
  "board_b_id": (
    match
      board-has-edge(board: $board, member-edge: $edge);
      $board has b_id $board_b_id;
    return first $board_b_id;
  ),
  "endpoint_1_n_id": $endpoint1.n_id,
  "endpoint_2_n_id": $endpoint2.n_id,
  "chunk_ids": [
    match
      edge-has-chunk(edge-owner: $edge, chunk: $chunk);
      $chunk has c_id $chunk_c_id;
    return {{ $chunk_c_id }};
  ]
}};
