match
  $inv isa investigation, has name "{investigation_name}";
fetch {{
  "investigation_name": $inv.name,
  "board_ids": [
    match
      inv-has-board(investigation: $inv, board: $board);
      $board has b_id $board_b_id;
    return {{ $board_b_id }};
  ],
  "canonical_entity_ids": [
    match
      inv-has-entity(investigation: $inv, can-entity: $entity);
      $entity has en_id $entity_en_id;
    return {{ $entity_en_id }};
  ]
}};
