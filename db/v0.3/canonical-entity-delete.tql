match
  $entity isa canonical-entity, has en_id {en_id};
  $merge isa entity-merged-to(source: $entity, target: $target);
select $merge;
distinct;
delete
  $merge;
end;

match
  $entity isa canonical-entity, has en_id {en_id};
  $merge isa entity-merged-to(source: $source, target: $entity);
select $merge;
distinct;
delete
  $merge;
end;

match
  $entity isa canonical-entity, has en_id {en_id};
  $entity-link isa entity-has-node(can-entity: $entity, node: $node);
  {{
    $edge isa edge, links (endpoint-1: $node, endpoint-2: $other);
  }} or {{
    $edge isa edge, links (endpoint-1: $other, endpoint-2: $node);
  }};
  $edge-link isa edge-has-chunk(edge-owner: $edge, chunk: $chunk);
select $edge-link, $chunk;
distinct;
delete
  $edge-link;
  $chunk;
end;

match
  $entity isa canonical-entity, has en_id {en_id};
  $entity-link isa entity-has-node(can-entity: $entity, node: $node);
  {{
    $edge isa edge, links (endpoint-1: $node, endpoint-2: $other);
  }} or {{
    $edge isa edge, links (endpoint-1: $other, endpoint-2: $node);
  }};
  $board-edge-link isa board-has-edge(board: $board, member-edge: $edge);
select $board-edge-link, $edge;
distinct;
delete
  $board-edge-link;
  $edge;
end;

match
  $entity isa canonical-entity, has en_id {en_id};
  $entity-link isa entity-has-node(can-entity: $entity, node: $node);
  $node-link isa node-has-chunk(node-owner: $node, chunk: $chunk);
select $node-link, $chunk;
distinct;
delete
  $node-link;
  $chunk;
end;

match
  $entity isa canonical-entity, has en_id {en_id};
  $entity-link isa entity-has-node(can-entity: $entity, node: $node);
  $board-node-link isa board-has-node(board: $board, member-node: $node);
select $entity-link, $board-node-link, $node;
distinct;
delete
  $entity-link;
  $board-node-link;
  $node;
end;

match
  $entity isa canonical-entity, has en_id {en_id};
  $inv-link isa inv-has-entity(investigation: $inv, can-entity: $entity);
delete
  $inv-link;
  $entity;
end;
