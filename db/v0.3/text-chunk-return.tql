match
  $chunk isa text-chunk, has c_id {c_id};
fetch {{
  "c_id": $chunk.c_id,
  "description": $chunk.description,
  "chunk_priority": $chunk.chunk_priority,
  "timecode": $chunk.timecode,
  "node_n_id": (
    match
      node-has-chunk(node-owner: $node, chunk: $chunk);
      $node has n_id $node_n_id;
    return first $node_n_id;
  ),
  "edge_ed_id": (
    match
      edge-has-chunk(edge-owner: $edge, chunk: $chunk);
      $edge has ed_id $edge_ed_id;
    return first $edge_ed_id;
  )
}};
