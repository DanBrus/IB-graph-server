match
  $node isa node, has n_id {n_id};
fetch {{
  "n_id": $node.n_id,
  "pos_x": $node.pos_x,
  "pos_y": $node.pos_y,
  "board_b_id": (
    match
      board-has-node(board: $board, member-node: $node);
      $board has b_id $board_b_id;
    return first $board_b_id;
  ),
  "entity_en_id": (
    match
      entity-has-node(can-entity: $entity, node: $node);
      $entity has en_id $entity_en_id;
    return first $entity_en_id;
  ),
  "edge_ids": [
    match
      {{
        $edge isa edge, links (endpoint-1: $node, endpoint-2: $other);
      }} or {{
        $edge isa edge, links (endpoint-1: $other, endpoint-2: $node);
      }};
      $edge has ed_id $edge_ed_id;
    select $edge_ed_id;
    distinct;
    return {{ $edge_ed_id }};
  ],
  "chunk_ids": [
    match
      node-has-chunk(node-owner: $node, chunk: $chunk);
      $chunk has c_id $chunk_c_id;
    return {{ $chunk_c_id }};
  ]
}};
