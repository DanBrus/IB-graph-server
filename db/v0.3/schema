define

attribute name,
 value string;
attribute board_id,
 value string;
attribute description,
 value string;
attribute is_published,
 value boolean;
attribute entity_id,
 value string;
attribute entity_type,
 value string;
attribute picture_path,
 value string;
attribute global_id,
 value integer;
attribute pos_x,
 value double;
attribute pos_y,
 value double;
attribute edge_id,
 value integer;
attribute chunk_text,
 value string;
attribute timecode,
 value string;
attribute chunk_priority,
 value long;

entity investigation,
  owns name @card(1..1),
  plays inv-has-board:investigation;

entity board,
  owns board_id @card(1..1),
  owns name @card(1..1),
  owns description @card(1..1),
  owns is_published @card(1..1),
  plays inv-has-board:board,
  plays board-has-node:board,
  plays board-has-edge:board;

entity canonical-entity,
  owns entity_id @card(1..1),
  owns name @card(1..1),
  owns entity_type @card(0..1),
  owns picture_path,
  plays entity-has-node:entity,
  plays entity-entity-alias:source,
  plays entity-entity-alias:target;

entity node,
  owns global_id @card(1..1),
  owns pos_x @card(1..1),
  owns pos_y @card(1..1),
  plays board-has-node:member-node,
  plays edge:endpoint-1,
  plays edge:endpoint-2,
  plays entity-has-node:node,
  plays node-has-chunk:node-owner;

entity info-chunk,
  owns chunk_text @card(1..1),
  owns timecode @card(0..1),
  owns chunk_priority @card(0..1),
  plays node-has-chunk:chunk,
  plays edge-has-chunk:chunk;

relation inv-has-board,
  relates investigation,
  relates board;

relation board-has-node,
  relates board,
  relates member-node;

relation edge,
  relates endpoint-1,
  relates endpoint-2,
  owns edge_id @card(1..1),
  plays board-has-edge:member-edge,
  plays edge-has-chunk:edge-owner;

relation board-has-edge,
  relates board,
  relates member-edge;

relation node-has-chunk,
  relates node-owner,
  relates chunk;

relation edge-has-chunk,
  relates edge-owner,
  relates chunk;

relation entity-has-node,
  relates entity,
  relates node;

relation entity-entity-alias,
  relates source,
  relates target;
