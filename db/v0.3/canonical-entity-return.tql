match
  $entity isa canonical-entity, has en_id {en_id};
fetch {{
  "en_id": $entity.en_id,
  "name": $entity.name,
  "entity_type": $entity.entity_type,
  "picture_paths": [
    match
      $entity has picture_path $picture_path;
    return {{ $picture_path }};
  ],
  "merged_to": (
    match
      entity-merged-to(source: $entity, target: $target);
      $target has en_id $target_en_id;
    return first $target_en_id;
  ),
  "investigation_name": (
    match
      inv-has-entity(investigation: $inv, can-entity: $entity);
      $inv has name $inv_name;
    return first $inv_name;
  ),
  "node_ids": [
    match
      entity-has-node(can-entity: $entity, node: $node);
      $node has n_id $node_n_id;
    return {{ $node_n_id }};
  ],
  "merged_to_en_ids": [
    match
      entity-merged-to(source: $entity, target: $target);
      $target has en_id $target_en_id;
    return {{ $target_en_id }};
  ],
  "merged_from_en_ids": [
    match
      entity-merged-to(source: $source, target: $entity);
      $source has en_id $source_en_id;
    return {{ $source_en_id }};
  ]
}};
